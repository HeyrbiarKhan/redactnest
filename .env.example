# RedactNest configuration.
#
# Every one of these is read and validated at module load, the caps and links by
# src/config/index.ts and the billing values by src/config/billing.ts. A missing
# or malformed value fails `next build` rather than becoming undefined at
# runtime, which on a cap would mean no cap at all.
#
# The caps are NEXT_PUBLIC_ because they are enforced in the browser, which is
# where the work happens, and none of them is a secret. Two billing values at
# the end are secrets (CLERK_SECRET_KEY and POLAR_ACCESS_TOKEN), so they are
# never NEXT_PUBLIC_ and never committed.

# Pages an anonymous visitor may redact. Must not exceed NEXT_PUBLIC_MAX_PAGES.
NEXT_PUBLIC_FREE_PAGE_CAP=3

# The paid ceiling. Raise above 50 only after measuring the real browser memory
# limit on a representative machine, allowing for more than one open tab.
NEXT_PUBLIC_MAX_PAGES=50

# The paid size ceiling, in bytes. 26214400 is 25 MB.
NEXT_PUBLIC_MAX_FILE_BYTES=26214400

# Characters of surrounding text shown either side of a match in the review
# checklist, so a match can be judged without opening the document again.
# Default 40, and 200 is the ceiling. That ceiling is a privacy limit rather
# than a display one: this text crosses the worker boundary, so a typo here must
# not be able to widen it to a whole page.
NEXT_PUBLIC_MATCH_CONTEXT_CHARS=40

# Canonical origin. Defaults to http://localhost:3000 in development; required,
# and must be https, in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The AGPL source offer link, for builds OFF Vercel only (CI, a local production
# build). Never set it on Vercel: there the link is worked out from the commit
# being built, and the build fails if this is set as well (spec 0009, AC-5).
# Required in a production build off Vercel, where it must be https and end in
# /tree/ followed by the full 40 character commit of THIS build. Never the
# repository root or a branch: the licence asks for the source of the exact
# version that is running.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/<owner>/redactnest/tree/<full commit>

# Billing: accounts through Clerk, the paid plan through Polar (spec 0012).
# All seven, or none. With none, billing is off: no Pro, no sign in, and no
# Clerk on any page. A partial set fails the build, naming what is missing.
# Test Clerk keys go with POLAR_ENVIRONMENT=sandbox, live keys with production,
# and only a Vercel production deploy may hold live keys. Never commit values.
#
# Clerk's publishable key (pk_test_ for a development instance, pk_live_ in
# production). It also names the Clerk domain.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only. Clerk's proxy and the account pages, and deleting a user.
# CLERK_SECRET_KEY=
# The instance's public key (PEM), for checking a sign in with no network call.
# Newlines may be written as \n.
# CLERK_JWT_KEY=
# Server only. An EdiventStudio organisation access token; sandbox and
# production tokens are separate.
# POLAR_ACCESS_TOKEN=
# sandbox or production.
# POLAR_ENVIRONMENT=
# The RedactNest Pro product, for checkout and the renewal date.
# POLAR_PRO_PRODUCT_ID=
# The RedactNest Pro feature flag benefit, the marker of Pro.
# POLAR_PRO_BENEFIT_ID=
