# RedactNest configuration.
#
# Every one of these is read and validated by src/config/index.ts at module load.
# A missing or malformed value fails `next build` rather than becoming undefined
# at runtime, which on a cap would mean no cap at all.
#
# All are NEXT_PUBLIC_ because the caps are enforced in the browser, which is
# where the work happens. None of them is a secret.

# Pages an anonymous visitor may redact. Must not exceed NEXT_PUBLIC_MAX_PAGES.
NEXT_PUBLIC_FREE_PAGE_CAP=3

# The paid ceiling. Raise above 50 only after measuring the real browser memory
# limit on a representative machine, allowing for more than one open tab.
NEXT_PUBLIC_MAX_PAGES=50

# The paid size ceiling, in bytes. 26214400 is 25 MB.
NEXT_PUBLIC_MAX_FILE_BYTES=26214400

# Characters of surrounding text shown either side of a match in the review
# checklist, so a match can be judged without opening the document again.
# Default 40, and 200 is the ceiling. That ceiling is a privacy limit rather
# than a display one: this text crosses the worker boundary, so a typo here must
# not be able to widen it to a whole page.
NEXT_PUBLIC_MATCH_CONTEXT_CHARS=40

# Canonical origin. Defaults to http://localhost:3000 in development; required,
# and must be https, in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The AGPL source offer link. Required in production. Point it at the tag or
# commit for THIS deploy, never the repository root: the licence asks for the
# source corresponding to the exact deployed version.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/<owner>/redactnest/tree/<commit>
