# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the example is documentation, not configuration, so it is committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/sync-engine.mjs from the pinned mupdf dependency
/public/engine/

# generated by scripts/sync-legal.mjs at every dev and build, so they always
# describe the tree that was built (spec 0009, INV-5)
/public/licence.txt
/public/third-party-notices.txt

# playwright
/test-results/
/playwright-report/

# agents files
/.agents/

# playwright mcp
.playwright-mcp/

# claude code worktrees
.claude/worktrees/
